# ============================================================================
# JARVIS Web OS — variáveis de ambiente
# Copie este arquivo para backend/.env e preencha os valores reais.
# NUNCA commite o .env real. Só este .env.example vai pro controle de versão.
# ============================================================================

# --- Autenticação (usuário único) ---
# Token que você vai digitar na tela de login. Escolha algo forte e único.
JARVIS_AUTH_TOKEN=troque-por-um-token-forte-aleatorio
# Segredo usado para assinar o cookie de sessão (HMAC). Gere com: openssl rand -hex 32
JARVIS_SESSION_SECRET=troque-por-32-bytes-aleatorios-em-hex

# --- JARVIS CORE (n8n) ---
# URL do webhook de chat do JARVIS CORE. Workflow precisa estar ATIVO no n8n.
# Formato típico do Chat Trigger: https://<instancia>/webhook/<webhookId>/chat
N8N_CHAT_WEBHOOK_URL=https://automacao-target-n8n.vr4mar.easypanel.host/webhook/468d1405-1c0c-4786-8734-6a74a1680dc2/chat
# Ativa o caminho de streaming (experimental). Deixe false até validar no n8n.
JARVIS_STREAMING_ENABLED=false

# --- n8n REST API (para o painel de workflows do dashboard) ---
N8N_API_URL=https://automacao-target-n8n.vr4mar.easypanel.host/api/v1
# Gere em: n8n → Settings → API → Create API Key
N8N_API_KEY=

# --- SPY (Supabase - CRM/ERP próprio da G-TECH) ---
# Leitura server-side dos KPIs: use a service-role key (a anon key é bloqueada pelo RLS e devolve 0/401).
SPY_SUPABASE_URL=https://snwkzvgompfgqoqbpihe.supabase.co
SPY_SUPABASE_SERVICE_ROLE_KEY=
SPY_TENANT_ID=27ef95ee-84dd-499e-9f25-cd9baecb5fe4

# --- WAHA (status da sessão WhatsApp — somente leitura de status nesta v1) ---
WAHA_URL=https://automacao-target-waha.vr4mar.easypanel.host
WAHA_API_KEY=
WAHA_SESSION=Jarvis

# --- Servidor ---
PORT=3001
NODE_ENV=production
# Origem do frontend, para CORS/cookies (deixe em branco se usar o proxy do nginx, mesmo domínio)
FRONTEND_ORIGIN=
